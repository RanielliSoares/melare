{
  "name": "melare-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional MELARE Construção Civil",
  "scripts": {
    "build": "npm run pages && npm run css",
    "css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "pages": "node scripts/build-pages.mjs",
    "images": "node scripts/optimize-images.mjs",
    "dist": "npm run build && node scripts/dist.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  }
}
